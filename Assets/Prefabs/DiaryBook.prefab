  m_text: "\u0420\u0435\u0448\u0435\u043D\u0438\u0435: \u041E\u0441\u043E\u0437\u043D\u0430\u0442\u044C
    \u0438 \u0440\u0430\u0437\u043E\u0440\u0432\u0430\u0442\u044C\r\n\u041F\u0440\u0435\u0434\u043C\u0435\u0442\u044B:
    \u041E\u0431\u0435\u0440\u0435\u0433 (\u043A\u0430\u043A \u0437\u0435\u0440\u043A\u0430\u043B\u043E
