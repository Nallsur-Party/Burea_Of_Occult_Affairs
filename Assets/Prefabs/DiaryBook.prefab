  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0420\u0435\u0448\u0435\u043D\u0438\u0435: \u0410\u043D\u043D\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0438\u043B\u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C\r\n\u041F\u0440\u0435\u0434\u043C\u0435\u0442\u044B:
    \u0413\u0440\u0438\u043C\u0443\u0430\u0440 + \u041E\u0436\u0435\u0440\u0435\u043B\u044C\u0435\r\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435:
    \u0412 \u0413\u0440\u0438\u043C\u0443\u0430\u0440\u0435 \u043D\u0430\u0439\u0442\u0438
    \u043F\u0443\u043D\u043A\u0442 \u043E \u0440\u0430\u0437\u0440\u044B\u0432\u0435,
    \u041E\u0436\u0435\u0440\u0435\u043B\u044C\u0435 \u0440\u0430\u0437\u043E\u0440\u0432\u0430\u0442\u044C
    (\u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0438 \u043F\u043E\u0440\u0432\u0430\u0442\u044C
    \u0446\u0435\u043F\u043E\u0447\u043A\u0443) \u2014 \u0438\u043B\u0438 \u043D\u0430\u043E\u0431\u043E\u0440\u043E\u0442,
    \u0437\u0430\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u043D\u043E\u0432\u043E\u0439
    \u043A\u0440\u043E\u0432\u044C\u044E"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
