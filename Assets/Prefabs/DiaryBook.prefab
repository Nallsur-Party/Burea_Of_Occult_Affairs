  m_text: "\u0420\u0435\u0448\u0435\u043D\u0438\u0435: \u041E\u0442\u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435
    + \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u044B\u0432\u0430\u043D\u0438\u0435\r\n\u041F\u0440\u0435\u0434\u043C\u0435\u0442\u044B:
    \u041E\u0436\u0435\u0440\u0435\u043B\u044C\u0435 + \u041E\u0431\u0435\u0440\u0435\u0433\r\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435:
    \u041E\u0436\u0435\u0440\u0435\u043B\u044C\u0435\u043C \u043E\u0431\u0432\u0435\u0441\u0442\u0438
    \u0432\u043E\u043A\u0440\u0443\u0433 NPC (\u043F\u0435\u0440\u0435\u0440\u0435\u0437\u0430\u0442\u044C
    \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u044B\u0435 \u043D\u0438\u0442\u0438),
    \u041E\u0431\u0435\u0440\u0435\u0433 \u043F\u043E\u0432\u0435\u0441\u0438\u0442\u044C
    \u0440\u044F\u0434\u043E\u043C \u043A\u0430\u043A \u043B\u043E\u0432\u0443\u0448\u043A\u0443"
