    \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u043E\u0433\u043E
    (\u043F\u043E\u0434\u043C\u0435\u043D\u0430 \u043E\u0442\u0448\u0430\u0442\u043D\u0451\u0442\u0441\u044F),
