  m_text: "\u0420\u0435\u0448\u0435\u043D\u0438\u0435: \u041D\u0430\u0439\u0442\u0438
    \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0442\u043E\u0433\u043E,
    \u043A\u0442\u043E \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\r\n\u041F\u0440\u0435\u0434\u043C\u0435\u0442\u044B:
    \u041E\u0431\u0435\u0440\u0435\u0433 + \u041E\u0436\u0435\u0440\u0435\u043B\u044C\u0435\r\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435:
    \u041E\u0431\u0435\u0440\u0435\u0433 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043D\u0430
    \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A (\u043A\u0430\u043A \u043A\u043E\u043C\u043F\u0430\u0441),
    \u041E\u0436\u0435\u0440\u0435\u043B\u044C\u0435\u043C \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u044C
    \u0441\u0438\u043C\u0432\u043E\u043B\u044B \u0440\u0438\u0442\u0443\u0430\u043B\u0430"
